!data/processed/experiment1/all_assets_summary_exp1_baseline.csv
!data/processed/experiment1/per_asset_summary.csv
!data/processed/experiment1/per_asset_summary.md
# Experiment 2 (selected ell* roll-ups backing the appendix table)
!data/processed/experiment2/**/selected_ell_by_window.txt
# Experiment 3
!data/processed/experiment3/base-gate/per_asset_summary.csv
!data/processed/experiment3/runs-gate/per_asset_summary.csv
