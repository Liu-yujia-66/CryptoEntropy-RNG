# Ignore generated experiment outputs by default, but keep small top-level
# result/summary files that back the thesis tables and numbers.
data/processed/**
!data/processed/**/
# data overview
!data/processed/data_overview/by_asset_summary.csv
!data/processed/data_overview/by_asset_month.csv
