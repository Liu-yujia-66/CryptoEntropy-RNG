!data/processed/experiment3/sanity_check/sanity_validity_matrix-k1000.csv
!data/processed/experiment3/sanity_check/sanity_validity_matrix-k1000.txt
# Experiment 4
!data/processed/experiment4/run.log
!data/processed/experiment4/calibration_all_subsets/all_subsets_summary.csv
!data/processed/experiment4/calibration_all_subsets/all_subsets_summary.json
